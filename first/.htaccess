<Files ~ "^\.(htaccess|htpasswd)$">
    deny from all
    </Files>
    Options -Indexes
    RewriteEngine on
    RewriteCond %{HTTP_HOST} ^(www\.kinoko\.ddns\.net/first)(:80)? [NC]
    RewriteRule ^(.*) http://kinoko.ddns.net/first/$1 [R=301,L]
    DirectoryIndex first.html       
    order deny,allow
    