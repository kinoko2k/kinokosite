<Files ~ "^\.(htaccess|htpasswd)$">
    deny from all
    </Files>
    Options -Indexes
    RewriteEngine on
    RewriteCond %{HTTP_HOST} ^(www\.kinoko\.ddns\.net/rule)(:80)? [NC]
    RewriteRule ^(.*) http://kinoko.ddns.net/rule/$1 [R=301,L]
    DirectoryIndex rule.html       
    order deny,allow
    